lab_df_eventid = conn.sql("""
    SELECT
        trim('"' FROM _source['event_id']::VARCHAR)        AS event_id,
        trim('"' FROM _source['log_name']::VARCHAR)        AS canal,
        trim('"' FROM _source['source_name']::VARCHAR)     AS provedor,
